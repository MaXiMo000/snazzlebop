# Copy to backend/.env for local development. Never commit real values.
ENV=development

# Required in production (>= 32 chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# In development a random one is generated at startup (rooms reset on every restart).
SECRET_KEY=

# SQLite locally; on Render this comes from the managed Postgres automatically.
DATABASE_URL=sqlite+aiosqlite:///./snazzlebop.db

# Comma-separated. Production: set automatically from RENDER_EXTERNAL_HOSTNAME.
# Add these only for a custom domain.
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

# Number of reverse proxies in front of the app (Render = 1, Cloudflare + Render = 2).
# Setting this too HIGH lets clients spoof their IP and dodge rate limits.
TRUSTED_PROXY_HOPS=1
# Or name a header your proxy overwrites with the client address on every request; then
# X-Forwarded-For is ignored. On Render (Cloudflare-fronted) this is the right setting:
# CLIENT_IP_HEADER=cf-connecting-ip
# Optional: refuse requests that lack the secret your own CDN adds as X-Edge-Auth.
# EDGE_SECRET=

# Optional capacity tuning
# MAX_ROOMS=300
# MAX_WS_PER_IP=40   (raise for a campus or office behind one shared address)
# MAX_WS_TOTAL=1500

# Optional: fresh game content from Claude (prompts, items, settings, clues...). Unset = built-in
# pools only, which is fine. Server-side only; never commit a real key. On Render set it in the
# dashboard (it is declared with sync: false in render.yaml, so the Blueprint never holds a value).
ANTHROPIC_API_KEY=
# Optional: voice and video calls through LiveKit (all three, or calls stay off). LiveKit Cloud:
# create a project, then Settings > Keys. Local testing: `livekit-server --dev` and
# LIVEKIT_URL=ws://localhost:7880 LIVEKIT_API_KEY=devkey LIVEKIT_API_SECRET=secret.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: Snazzlebop Plus, a monthly membership sold through Paddle (merchant of record: worldwide
# payments in local currencies, tax handled). Needs the client-side token, the webhook secret and the
# Plus price id; the API key only adds "change or cancel". In Paddle: create a monthly price, then a
# notification destination for https://<site>/api/billing/paddle with subscription.* and
# transaction.completed events. Try it with PADDLE_ENV=sandbox first. Unset = no Plus.
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PLUS_PRICE=
PADDLE_API_KEY=
# Optional: Google AdSense display ads on the lobby and results screens (never during a game, never
# for Plus members). Both, or no ads. Unset = no ads.
ADSENSE_CLIENT=
ADSENSE_SLOT=
# Optional: email addresses (comma-separated) that get Plus free: no ads, emote packs, the badge.
# Only counts once the address is confirmed on the account. Personal data: set it in the dashboard.
PLUS_FRIENDS=
# CONTENT_MODEL=claude-opus-5-5
# CONTENT_CALLS_PER_HOUR=20

# The same list gives those friends a walk-on (a title card and a jingle the whole room sees).
# The prank: a ghost and a scream for the names listed in JUMPSCARE_NAMES when they join and when scores
# come up. No names ship with the code, so with none set nobody is pranked. JUMPSCARE=false turns it off.
# JUMPSCARE=false
# JUMPSCARE_NAMES=Name1,Name2

# Optional: account email (confirm an address, reset links, security notices). Unset = no email;
# accounts keep working with the recovery code. Either Resend (needs a verified domain) or any SMTP
# server, plus MAIL_FROM. PUBLIC_URL is the address links in emails point at (defaults to the
# Render hostname). Development only: MAIL_OUTBOX_DIR writes each email to that folder as files.
# MAIL_FROM=Snazzlebop <hello@example.com>
# RESEND_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# PUBLIC_URL=https://snazzlebop.example.com
# MAIL_OUTBOX_DIR=../.dev/outbox

# Optional: sign in with Google. Create an OAuth client (type "Web application") in Google Cloud and
# add <PUBLIC_URL>/api/auth/google/callback as an authorised redirect URI. Unset = no Google button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Shown on the privacy notice as the place to send privacy requests (for example an email address).
# PRIVACY_CONTACT=
# Who runs the site: the legal name (as on your Paddle account), shown on Terms and Privacy.
# OPERATOR_NAME=

# Optional: connect report handling to other systems (see README, Integrations). Each change to a
# report is POSTed to the webhook, signed with the secret (32+ chars); the token (32+ chars) lets a
# system such as Jira or an AI triage service read cases and write back.
# Platform staff (comma separated usernames). They also need an authenticator app turned on.
# STAFF_USERNAMES=
# REPORT_WEBHOOK_URL=https://example.com/hooks/snazzlebop
# REPORT_WEBHOOK_SECRET=
# INTEGRATION_TOKEN=
